MAILGUN_API_KEY=key-your-mailgun-private-api-key
MAILGUN_FROM="Zamac Füds <orders@mg.example.com>"
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-paystack-test-secret
PUBLIC_BASE_URL=http://localhost:8000
